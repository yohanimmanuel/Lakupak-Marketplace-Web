# Lakupak Dashboard hosts the marketplace API (GraphQL + /api/mobile REST).
# All browser traffic is proxied through this app, so these URLs stay server-side.
#
# `npm run dev`  → *_DEV  (NODE_ENV=development)
# production build / Render → *_PROD  (NODE_ENV=production)
# Docker Compose → sets LAKU_API_BASE_URL (overrides both); see DOCKER_LAKU_API_BASE_URL
LAKU_API_BASE_URL_DEV=http://localhost:3000
LAKU_API_BASE_URL_PROD=https://lakupak-dashboard.onrender.com

# Optional hard override (wins over DEV/PROD). Leave unset for automatic selection.
# LAKU_API_BASE_URL=http://localhost:3000

# Public canonical origin of this website (share links, OG tags).
# For Docker, rebuild after changing NEXT_PUBLIC_* (they are baked at build time).
NEXT_PUBLIC_SITE_URL_DEV=http://localhost:3002
NEXT_PUBLIC_SITE_URL_PROD=https://lakupak-marketplace-web.onrender.com

# Deep link scheme of the Lakupak Marketplace mobile app (open-in-app CTAs).
NEXT_PUBLIC_APP_SCHEME=lakupak

# Store links shown in the install CTAs.
NEXT_PUBLIC_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.laku.marketplace
NEXT_PUBLIC_IOS_STORE_URL=https://apps.apple.com/app/laku

# Lakupak Dashboard marketing site (distributor / seller entry point).
NEXT_PUBLIC_DASHBOARD_URL_DEV=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL_PROD=https://lakupak-dashboard.onrender.com

# Public Mapbox token (pk…) for streets-v12 address preview on signup.
# Same role as EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN in Laku-Marketplace (mobile repo folder name).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
