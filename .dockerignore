# Dependencies (build runs inside Docker; builder creates its own .next)
node_modules
.next
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
dev-out.log
dev-err.log

# Git and IDE
.git
.gitignore
.idea
*.md
!env.example
.vscode
.cursor

# Environment (use env_file or compose env instead)
.env
.env.*
!.env.example
!env.example

# Build/cache (not needed in image)
.turbo
dist
.cache
*.tsbuildinfo
.eslintcache
.vercel

# Tests and coverage (not needed at runtime)
coverage
**/__tests__
**/*.test.*
**/*.spec.*
**/__snapshots__

# Misc
Dockerfile*
docker-compose*
.dockerignore
Thumbs.db
